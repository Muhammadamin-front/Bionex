{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The site's address will be https://zeynara.<your-subdomain>.workers.dev
  "name": "zeynara",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  // The built website (apps/web/dist). Requests to /api/* go to the Worker first.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/api/*", "/panel", "/crm", "/video/*"],
    "not_found_handling": "single-page-application"
  },

  // One small database object that remembers recent orders: duplicates, per-IP limits,
  // and orders waiting for Telegram if it was unreachable.
  "durable_objects": {
    "bindings": [{ "name": "REGISTRY", "class_name": "LeadRegistry" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LeadRegistry"] }],

  // The day's report to the operators' group at 20:00 Tashkent time (15:00 UTC), and every
  // 5 minutes the partner sheet's «Keraksiz» marks (PARTNER_SHEET_CRON in src/index.ts).
  "triggers": { "crons": ["0 15 * * *", "*/5 * * * *"] },

  "vars": {
    // Order attempts one PHONE (its device id; the network when it has none) may make per hour,
    // failed ones too. Since 2026-10-29 it no longer counts the network: mobile operators put many
    // customers behind one address. The network itself is capped only against floods (registry.ts
    // NETWORK_ATTEMPTS_PER_HOUR). The names stay for compatibility.
    "IP_ORDERS_PER_HOUR": "3",
    // How many different phone numbers one PHONE (device id; else the network) may order for per day.
    "LEADS_PER_IP_PER_DAY": "3",
    // The same number again within this time is a repeat, not a new order.
    "DUPLICATE_WINDOW_HOURS": "24",
    // Every this many new orders, the group also gets them as one numbered list. 0 = off.
    "LEADS_PER_LIST": "10",
    // The partner site's Pixel (apps/partner, docs/PARTNER-SITE.md). Public: it is in that
    // site's page anyway. Its Conversions API token is the secret META_T2_CAPI_TOKEN.
    "META_T2_PIXEL_ID": "1783794022832394",
    // The main page's own domain (apps/site, a Pages site that forwards each order here as a post to
    // this Worker's address). Its «not a robot» checks are solved there, so they are accepted for it.
    // The Turnstile widget's Hostnames list in Cloudflare must include it too.
    "MAIN_SITE_HOSTS": "zeynara.com.uz"
  }
  // Secrets (never in this file): set once with `npx wrangler secret put NAME`
  //   TURNSTILE_SECRET_KEY, TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID
  //   META_PIXEL_ID, META_CAPI_TOKEN — optional, both or neither: the server-side copy of
  //   the Lead event for Meta ads. Without them leads are reported from the browser only.
}
