# Frontend configuration (copy to apps/web/.env). These values are PUBLIC — they end
# up in the JavaScript bundle. Never put a secret in a VITE_ variable.

# Turnstile SITE key (public). Local development: Cloudflare's "always passes" test key.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Canonical site URL, used for Open Graph tags.
VITE_SITE_URL=http://localhost:5173

# Meta (Facebook) Pixel ID. Empty = no tracking (recommended for local development).
# The previous site used 1079627421633529 — set it in PRODUCTION only.
VITE_META_PIXEL_ID=
